<?xml version="1.0" encoding="UTF-8"?>
<phpunit bootstrap="vendor/autoload.php"
         colors="true"
         verbose="false"
         stopOnFailure="false">

    <!-- Define where PHPUnit should look for tests -->
    <testsuites>
        <testsuite name="Unit Tests">
            <directory>tests</directory>
        </testsuite>
    </testsuites>

    <!-- Filter code coverage (optional) -->
    <coverage processUncoveredFiles="false">
        <include>
            <directory suffix=".php">src</directory>
        </include>
        <exclude>
            <directory suffix=".php">src/Util</directory> <!-- if you want to skip utility code -->
        </exclude>
    </coverage>

    <!-- Any environment variables you want available in tests -->
    <php>
        <ini name="memory_limit" value="512M"/>
        <ini name="error_reporting" value="-1"/>
    </php>

    <!-- Logging outputs (optional) -->
    <logging>
        <!-- junit report for CI servers -->
        <junit outputFile="build/logs/junit.xml"/>
        <!-- HTML coverage report -->
        <log type="coverage-html" target="build/coverage"/>
    </logging>
</phpunit>
